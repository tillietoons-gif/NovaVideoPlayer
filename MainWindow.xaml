<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aster Player">

    <Grid x:Name="RootGrid" RequestedTheme="Light" Background="#f4f6fb" Padding="20" AllowDrop="True"
          DragOver="RootGrid_DragOver" DragEnter="RootGrid_DragEnter"
          DragLeave="RootGrid_DragLeave" Drop="RootGrid_Drop"
          KeyDown="RootGrid_KeyDown" IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="QueueColumn" Width="280" />
        </Grid.ColumnDefinitions>

        <Border x:Name="HeaderPanel" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20" Padding="16,8"
                CornerRadius="16" BorderBrush="#80FFFFFF" BorderThickness="1">
            <Border.Background>
                <AcrylicBrush TintColor="#F7F8FF" TintOpacity="0.76"
                              FallbackColor="#F2F4FA" />
            </Border.Background>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#7054d8">
                        <SymbolIcon Symbol="Video" Foreground="White"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Aster Player" FontSize="19" FontWeight="SemiBold"
                                   Foreground="#172033" />
                        <TextBlock Text="Your library, ready to play" FontSize="12"
                                   Foreground="#68748a" />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Hidden" MaxWidth="520"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <AppBarToggleButton x:Name="CompactModeButton" Click="CompactMode_Click"
                                            IsChecked="False"
                                            ToolTipService.ToolTip="Hide or show the play queue"
                                            AutomationProperties.Name="Toggle compact mode"
                                            VerticalAlignment="Center">
                            <AppBarToggleButton.Icon>
                                <SymbolIcon Symbol="ViewAll" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarButton x:Name="OpenVideoButton" Click="OpenVideo_Click"
                                      ToolTipService.ToolTip="Choose video or audio files"
                                      AutomationProperties.Name="Open media"
                                      VerticalAlignment="Center">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="OpenFile" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="OpenStreamButton" Click="OpenStream_Click"
                                      ToolTipService.ToolTip="Open a network stream"
                                      AutomationProperties.Name="Open network stream"
                                      VerticalAlignment="Center">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="World" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="VideoSurface" Grid.Row="1" Grid.Column="0" Margin="0,0,18,18" CornerRadius="18"
                Background="#e9edf5" BorderBrush="#d9dfeb" BorderThickness="1">
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#f4f6fb" Offset="0" />
                        <GradientStop Color="#e9edf5" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <MediaPlayerElement x:Name="VideoPlayer" AutoPlay="False" AreTransportControlsEnabled="False"
                                    Stretch="Uniform" />
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" IsHitTestVisible="False" MaxWidth="420">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </StackPanel.Transitions>
                    <Border Width="90" Height="90" CornerRadius="45" Background="#e8e4f8"
                            HorizontalAlignment="Center" BorderBrush="#d8d0f2" BorderThickness="1">
                        <SymbolIcon Symbol="Video" Foreground="#7054d8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Your next watch starts here" FontSize="24" FontWeight="SemiBold"
                               Foreground="#202a3e" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="Open a video, stream, or drag in a few files to build your queue"
                               FontSize="13" Foreground="#657188" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Margin="20" Padding="16,12" CornerRadius="16" BorderThickness="1"
                        BorderBrush="#80FFFFFF" IsTabStop="False">
                    <Border.Background>
                        <AcrylicBrush TintColor="#F7F8FF" TintOpacity="0.78"
                                      FallbackColor="#F2F4FA" />
                    </Border.Background>
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="12" Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText" Text="00:00" VerticalAlignment="Center"
                                       FontSize="12" FontFamily="Consolas" Foreground="#344054" />
                            <Slider Grid.Column="1" x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0"
                                    ValueChanged="SeekSlider_ValueChanged" VerticalAlignment="Center"
                                    IsEnabled="False" />
                            <TextBlock Grid.Column="2" x:Name="DurationText" Text="00:00"
                                       VerticalAlignment="Center" FontSize="12" FontFamily="Consolas"
                                       Foreground="#344054" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="NOW PLAYING" FontSize="10" CharacterSpacing="100"
                                           Foreground="#68748a" />
                                <TextBlock x:Name="NowPlayingText" Text="Choose a video"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#202a3e"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock x:Name="StatusText" Text="Ready when you are"
                                           FontSize="10" Foreground="#68748a"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTipService.ToolTip="Space: play/pause · arrows: seek/volume · M: mute · F: fullscreen" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                <AppBarButton x:Name="PreviousButton" Click="Previous_Click"
                                              ToolTipService.ToolTip="Previous video (or restart current)"
                                              AutomationProperties.Name="Previous video">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Previous" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="BackTenButton" Click="SeekBackward_Click"
                                              ToolTipService.ToolTip="Back 10 seconds"
                                              AutomationProperties.Name="Back 10 seconds">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Back" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="PlayPauseButton" Click="PlayPause_Click"
                                              ToolTipService.ToolTip="Play"
                                              AutomationProperties.Name="Play">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Play" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="ForwardTenButton" Click="SeekForward_Click"
                                              ToolTipService.ToolTip="Forward 10 seconds"
                                              AutomationProperties.Name="Forward 10 seconds">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Forward" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="NextButton" Click="Next_Click"
                                              ToolTipService.ToolTip="Next video"
                                              AutomationProperties.Name="Next video">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Next" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <AppBarToggleButton x:Name="MuteButton" Click="Mute_Click"
                                                    ToolTipService.ToolTip="Mute"
                                                    AutomationProperties.Name="Mute">
                                    <AppBarToggleButton.Icon>
                                        <SymbolIcon Symbol="Volume" />
                                    </AppBarToggleButton.Icon>
                                </AppBarToggleButton>
                                <Slider x:Name="VolumeSlider" Width="88" Minimum="0" Maximum="100"
                                        Value="70" ValueChanged="VolumeSlider_ValueChanged"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Volume"
                                        AutomationProperties.Name="Volume" />
                            </StackPanel>
                            <AppBarButton x:Name="MoreActionsButton" Grid.Column="3"
                                          ToolTipService.ToolTip="More playback actions"
                                          AutomationProperties.Name="More playback actions"
                                          VerticalAlignment="Center">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="More" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel MinWidth="280" Spacing="12" Padding="8">
                                            <TextBlock Text="Playback options" FontSize="15"
                                                       FontWeight="SemiBold" Foreground="#202a3e" />
                                            <StackPanel Orientation="Horizontal" Spacing="12"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Speed" Width="72"
                                                           VerticalAlignment="Center" Foreground="#58657c" />
                                                <ComboBox x:Name="SpeedPicker" Width="150" SelectedIndex="2"
                                                          ToolTipService.ToolTip="Playback speed"
                                                          AutomationProperties.Name="Playback speed"
                                                          SelectionChanged="SpeedPicker_SelectionChanged">
                                                    <ComboBoxItem Content="0.5×" />
                                                    <ComboBoxItem Content="0.75×" />
                                                    <ComboBoxItem Content="1×" />
                                                    <ComboBoxItem Content="1.25×" />
                                                    <ComboBoxItem Content="1.5×" />
                                                    <ComboBoxItem Content="2×" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <AppBarToggleButton x:Name="ShuffleButton" Click="Shuffle_Click"
                                                                    ToolTipService.ToolTip="Shuffle queue"
                                                                    AutomationProperties.Name="Shuffle queue">
                                                    <AppBarToggleButton.Icon>
                                                        <SymbolIcon Symbol="Shuffle" />
                                                    </AppBarToggleButton.Icon>
                                                </AppBarToggleButton>
                                                <AppBarToggleButton x:Name="RepeatButton" Click="Repeat_Click"
                                                                    ToolTipService.ToolTip="Repeat the current video"
                                                                    AutomationProperties.Name="Repeat current video">
                                                    <AppBarToggleButton.Icon>
                                                        <SymbolIcon Symbol="RepeatOne" />
                                                    </AppBarToggleButton.Icon>
                                                </AppBarToggleButton>
                                                <AppBarButton x:Name="StopButton" Click="Stop_Click"
                                                              ToolTipService.ToolTip="Stop"
                                                              AutomationProperties.Name="Stop">
                                                    <AppBarButton.Icon>
                                                        <SymbolIcon Symbol="Stop" />
                                                    </AppBarButton.Icon>
                                                </AppBarButton>
                                            </StackPanel>
                                            <TextBlock Text="Subtitles" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#58657c" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ComboBox x:Name="SubtitlePicker" Width="180" SelectedIndex="0"
                                                          ToolTipService.ToolTip="Subtitle track"
                                                          AutomationProperties.Name="Subtitle track"
                                                          SelectionChanged="SubtitlePicker_SelectionChanged">
                                                    <ComboBoxItem Content="Subtitles off" />
                                                </ComboBox>
                                                <AppBarButton x:Name="OpenSubtitleButton" Click="OpenSubtitle_Click"
                                                              ToolTipService.ToolTip="Load an external subtitle file"
                                                              AutomationProperties.Name="Load subtitles">
                                                    <AppBarButton.Icon>
                                                        <SymbolIcon Symbol="Caption" />
                                                    </AppBarButton.Icon>
                                                </AppBarButton>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Stereo balance" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#58657c" />
                                                <Slider x:Name="AudioBalanceSlider" Minimum="-100" Maximum="100"
                                                        Value="0" ValueChanged="AudioBalanceSlider_ValueChanged"
                                                        ToolTipService.ToolTip="Stereo balance: left to right"
                                                        AutomationProperties.Name="Stereo balance" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarButton x:Name="FullWindowButton" Grid.Column="4" Click="FullWindow_Click"
                                          ToolTipService.ToolTip="Toggle full-screen video"
                                          AutomationProperties.Name="Full screen"
                                          VerticalAlignment="Center">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="FullScreen" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#EAF0FB"
                        BorderBrush="#8067df" BorderThickness="2" CornerRadius="18"
                        IsHitTestVisible="False">
                    <Border.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </Border.Transitions>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <SymbolIcon Symbol="Add" Foreground="#7054d8"
                                    HorizontalAlignment="Center" />
                        <TextBlock Text="Drop media or subtitles"
                                   Foreground="#202a3e" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Media joins the queue · subtitles attach to the current item"
                                   Foreground="#657188" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="QueuePanel" Grid.Row="1" Grid.Column="1" Margin="0,0,0,18" Padding="18" CornerRadius="18"
                Background="#ffffff" BorderBrush="#dfe4ee" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Play queue" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#202a3e" />
                        <TextBlock x:Name="QueueCountText" Text="0 videos"
                                   FontSize="12" Foreground="#68748a" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <AppBarButton x:Name="RemoveQueueItemButton" Click="RemoveQueueItem_Click"
                                      IsEnabled="False" ToolTipService.ToolTip="Remove selected item"
                                      AutomationProperties.Name="Remove selected item">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Remove" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="ClearQueueButton" Click="ClearQueue_Click"
                                      IsEnabled="False" ToolTipService.ToolTip="Clear the play queue"
                                      AutomationProperties.Name="Clear queue">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Delete" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <ListView x:Name="PlaylistView" SelectionChanged="Playlist_SelectionChanged"
                              SelectionMode="Single" Background="Transparent" BorderThickness="0"
                              Foreground="#202a3e" Padding="0">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                    <Grid Padding="8,10" ColumnSpacing="10" CornerRadius="10"
                                          Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="7" Background="#eef1f8"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <SymbolIcon Symbol="Video" Foreground="#7054d8"
                                                        VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13"
                                                   Foreground="#202a3e" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="QueueEmptyState" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </StackPanel.Transitions>
                        <SymbolIcon Symbol="Play" Foreground="#8792a6"
                                    HorizontalAlignment="Center" />
                        <TextBlock Text="Nothing in the queue yet" FontSize="13"
                                   Foreground="#58657c" HorizontalAlignment="Center" />
                        <TextBlock Text="Add videos to build your watch list"
                                   FontSize="11" Foreground="#7a869b" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
