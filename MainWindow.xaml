<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aster Player">

    <Grid x:Name="RootGrid" Background="#0b0d12" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,16,16" CornerRadius="12"
                Background="#050608" BorderBrush="#242a35" BorderThickness="1">
            <Grid>
                <MediaPlayerElement x:Name="VideoPlayer" AutoPlay="False" AreTransportControlsEnabled="False"
                                    Stretch="Uniform" />
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE714;" FontSize="42" Foreground="#778196"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Open a video to start watching" FontSize="18"
                               Foreground="#d9deea" HorizontalAlignment="Center" />
                    <TextBlock Text="Your playlist and playback controls are right here"
                               FontSize="13" Foreground="#778196" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,16" Padding="16" CornerRadius="12"
                Background="#121620" BorderBrush="#242a35" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="PLAY QUEUE" FontSize="12" FontWeight="SemiBold"
                           CharacterSpacing="120" Foreground="#aeb7c8" />
                <Button Grid.Row="1" x:Name="OpenVideoButton" Click="OpenVideo_Click"
                        Content="＋   Add videos" HorizontalAlignment="Stretch" Margin="0,14,0,12"
                        Height="42" />
                <ListView Grid.Row="2" x:Name="PlaylistView"
                          SelectionChanged="Playlist_SelectionChanged" SelectionMode="Single"
                          Background="Transparent" BorderThickness="0"
                          Foreground="#e8edf7" />
                <TextBlock Grid.Row="3" x:Name="QueueCountText" Text="0 videos"
                           FontSize="12" Foreground="#778196" Margin="0,12,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="18,14" CornerRadius="12"
                Background="#121620" BorderBrush="#242a35" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="00:00" VerticalAlignment="Center"
                               FontSize="12" Foreground="#aeb7c8" />
                    <Slider Grid.Column="1" x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0"
                            ValueChanged="SeekSlider_ValueChanged" VerticalAlignment="Center"
                            IsEnabled="False" />
                    <TextBlock Grid.Column="2" x:Name="DurationText" Text="00:00"
                               VerticalAlignment="Center" FontSize="12" Foreground="#aeb7c8" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="OpenBottomButton" Click="OpenVideo_Click" Content="Open" />
                        <Button x:Name="BackTenButton" Click="SeekBackward_Click" Content="−10s" ToolTipService.ToolTip="Back 10 seconds" />
                        <Button x:Name="PreviousButton" Click="Previous_Click" Content="|◀" ToolTipService.ToolTip="Previous video" />
                        <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Content="Play" MinWidth="76" />
                        <Button x:Name="StopButton" Click="Stop_Click" Content="Stop" />
                        <Button x:Name="NextButton" Click="Next_Click" Content="▶|" ToolTipService.ToolTip="Next video" />
                        <Button x:Name="ForwardTenButton" Click="SeekForward_Click" Content="+10s" ToolTipService.ToolTip="Forward 10 seconds" />
                        <ToggleButton x:Name="RepeatButton" Content="Repeat" ToolTipService.ToolTip="Repeat the current video" />
                        <Button x:Name="FullWindowButton" Click="FullWindow_Click" Content="Full screen"
                                ToolTipService.ToolTip="Toggle video full window" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ready"
                               VerticalAlignment="Center" FontSize="13" Foreground="#c7cfdd"
                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Speed" VerticalAlignment="Center" FontSize="12"
                                   Foreground="#aeb7c8" />
                        <ComboBox x:Name="SpeedPicker" Width="90" SelectedIndex="2"
                                  SelectionChanged="SpeedPicker_SelectionChanged">
                            <ComboBoxItem Content="0.5×" />
                            <ComboBoxItem Content="0.75×" />
                            <ComboBoxItem Content="1×" />
                            <ComboBoxItem Content="1.25×" />
                            <ComboBoxItem Content="1.5×" />
                            <ComboBoxItem Content="2×" />
                        </ComboBox>
                        <Button x:Name="MuteButton" Click="Mute_Click" Content="Mute" />
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100"
                                Value="70" ValueChanged="VolumeSlider_ValueChanged"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
