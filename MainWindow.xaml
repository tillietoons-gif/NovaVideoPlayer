<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aster Player">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="#0B0D13" Padding="16" AllowDrop="True"
          DragOver="RootGrid_DragOver" DragEnter="RootGrid_DragEnter"
          DragLeave="RootGrid_DragLeave" Drop="RootGrid_Drop"
          PointerMoved="RootGrid_PointerMoved"
          KeyDown="RootGrid_KeyDown" IsTabStop="True">
        <Grid.Resources>
            <!-- Brand accent theme for sliders and highlights -->
            <SolidColorBrush x:Key="AccentColorBrush" Color="#7C5CFC" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#7C5CFC" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#906EFC" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#6D46FA" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E2E8F0" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#252A3D" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#30374E" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#30374E" />

            <!-- Clean custom style for media transport AppBarButtons -->
            <Style x:Key="MediaTransportButtonStyle" TargetType="AppBarButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#94A3B8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="AppBarButton">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="#252A3D" />
                                                <Setter Target="IconPresenter.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="#1A1E2C" />
                                                <Setter Target="IconPresenter.Foreground" Value="#7C5CFC" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="IconPresenter"
                                                  Content="{TemplateBinding Icon}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Prominent circular Play/Pause button style -->
            <Style x:Key="PrimaryPlayButtonStyle" TargetType="AppBarButton">
                <Setter Property="Background" Value="#7C5CFC" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="AppBarButton">
                            <Border x:Name="PlayRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="PlayRoot.Background" Value="#8B6DFE" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="PlayRoot.Background" Value="#6945EA" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="PlayRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Icon}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Clean custom style for toggle AppBarButtons (Shuffle, Repeat, CompactMode) -->
            <Style x:Key="MediaToggleButtonStyle" TargetType="AppBarToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#94A3B8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="AppBarToggleButton">
                            <Border x:Name="ToggleBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ToggleBorder.Background" Value="#252A3D" />
                                                <Setter Target="ToggleIcon.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ToggleBorder.Background" Value="#1A1E2C" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ToggleBorder.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="ToggleBorder.Background" Value="#2B2150" />
                                                <Setter Target="ToggleBorder.BorderBrush" Value="#7C5CFC" />
                                                <Setter Target="ToggleBorder.BorderThickness" Value="1" />
                                                <Setter Target="ToggleIcon.Foreground" Value="#A78BFA" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ToggleIcon"
                                                  Content="{TemplateBinding Icon}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact mute toggle button inside volume pill -->
            <Style x:Key="MuteToggleButtonStyle" TargetType="AppBarToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#94A3B8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="AppBarToggleButton">
                            <Border x:Name="MuteBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="MuteBorder.Background" Value="#2D3349" />
                                                <Setter Target="MuteIcon.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="MuteBorder.Background" Value="#1E2333" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="MuteBorder.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="MuteBorder.Background" Value="#451A22" />
                                                <Setter Target="MuteIcon.Foreground" Value="#F87171" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="MuteIcon"
                                                  Content="{TemplateBinding Icon}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Clean button style for queue header actions -->
            <Style x:Key="QueueActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#94A3B8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ActionBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ActionBorder.Background" Value="#252A3D" />
                                                <Setter Target="ActionPresenter.Foreground" Value="#F1F5F9" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ActionBorder.Background" Value="#1A1E2C" />
                                                <Setter Target="ActionPresenter.Foreground" Value="#7C5CFC" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ActionBorder.Opacity" Value="0.3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ActionPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="QueueColumn" Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Video Player Surface -->
        <Border x:Name="VideoSurface" Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" CornerRadius="16"
                Background="#06070A" BorderBrush="#1E2332" BorderThickness="1">
            <Grid>
                <MediaPlayerElement x:Name="VideoPlayer" AutoPlay="False" AreTransportControlsEnabled="False"
                                    Stretch="Uniform" />

                <!-- Empty State Card (Dark glassmorphic style) -->
                <Border x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#131622" BorderBrush="#252B3E" BorderThickness="1"
                        CornerRadius="20" Padding="36,32" MaxWidth="460" IsHitTestVisible="False">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Spacing="14">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </StackPanel.Transitions>
                        <Border Width="72" Height="72" CornerRadius="36" Background="#241C42"
                                HorizontalAlignment="Center" BorderBrush="#3D2D6E" BorderThickness="1">
                            <SymbolIcon Symbol="Video" Foreground="#A78BFA"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Your next watch starts here" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#F8FAFC" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="Open a video, stream, or drag and drop media files into the player to start watching."
                                   FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="WrapWholeWords" LineHeight="19" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
                            <Border Background="#1C2030" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="Space : Play/Pause" FontSize="11" Foreground="#CBD5E1" />
                            </Border>
                            <Border Background="#1C2030" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="M : Mute" FontSize="11" Foreground="#CBD5E1" />
                            </Border>
                            <Border Background="#1C2030" BorderBrush="#2A3045" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="F : Fullscreen" FontSize="11" Foreground="#CBD5E1" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Floating Playback Controls Bar -->
                <Border x:Name="ControlsBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Margin="16" Padding="16,12" CornerRadius="16" BorderThickness="1"
                        BorderBrush="#2E354B" IsTabStop="False"
                        PointerEntered="ControlsBar_PointerEntered"
                        PointerExited="ControlsBar_PointerExited">
                    <Border.Transitions>
                        <TransitionCollection>
                            <ContentThemeTransition />
                        </TransitionCollection>
                    </Border.Transitions>
                    <Border.Background>
                        <AcrylicBrush TintColor="#121520" TintOpacity="0.88"
                                      FallbackColor="#121520" />
                    </Border.Background>
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Timeline Seek Bar -->
                        <Grid Grid.Row="0" ColumnSpacing="12" Margin="2,0,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText" Text="00:00" VerticalAlignment="Center"
                                       FontSize="12" FontFamily="Segoe UI Variable Text, Consolas" FontWeight="Medium" Foreground="#94A3B8" />
                            <Slider Grid.Column="1" x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0"
                                    ValueChanged="SeekSlider_ValueChanged" VerticalAlignment="Center"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Seek (Left / Right arrow keys)" />
                            <TextBlock Grid.Column="2" x:Name="DurationText" Text="00:00"
                                       VerticalAlignment="Center" FontSize="12" FontFamily="Segoe UI Variable Text, Consolas" FontWeight="Medium"
                                       Foreground="#94A3B8" />
                        </Grid>

                        <!-- Main Controls Row: Left (Info), Center (Transport), Right (Volume/Actions) -->
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Now Playing Info -->
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="NOW PLAYING" FontSize="10" CharacterSpacing="100" FontWeight="SemiBold"
                                           Foreground="#64748B" />
                                <TextBlock x:Name="NowPlayingText" Text="Choose a video"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock x:Name="StatusText" Text="Ready when you are"
                                           FontSize="11" Foreground="#94A3B8"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTipService.ToolTip="Space: play/pause · arrows: seek/volume · M: mute · F: fullscreen · P: PiP · S: snapshot · A: aspect" />
                            </StackPanel>

                            <!-- Center: Transport Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                <AppBarButton x:Name="PreviousButton" Click="Previous_Click"
                                              Style="{StaticResource MediaTransportButtonStyle}"
                                              ToolTipService.ToolTip="Previous video (or restart current)"
                                              AutomationProperties.Name="Previous video">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Previous" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="BackTenButton" Click="SeekBackward_Click"
                                              Style="{StaticResource MediaTransportButtonStyle}"
                                              ToolTipService.ToolTip="Back 10 seconds (Left arrow)"
                                              AutomationProperties.Name="Back 10 seconds">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Back" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="PlayPauseButton" Click="PlayPause_Click"
                                              Style="{StaticResource PrimaryPlayButtonStyle}"
                                              ToolTipService.ToolTip="Play / Pause (Space)"
                                              AutomationProperties.Name="Play">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Play" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="ForwardTenButton" Click="SeekForward_Click"
                                              Style="{StaticResource MediaTransportButtonStyle}"
                                              ToolTipService.ToolTip="Forward 10 seconds (Right arrow)"
                                              AutomationProperties.Name="Forward 10 seconds">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Forward" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="NextButton" Click="Next_Click"
                                              Style="{StaticResource MediaTransportButtonStyle}"
                                              ToolTipService.ToolTip="Next video"
                                              AutomationProperties.Name="Next video">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Next" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </StackPanel>

                            <!-- Right: Volume & Utility Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <!-- Volume Pill -->
                                <Border VerticalAlignment="Center"
                                        Background="#181C2B" BorderBrush="#282E42" BorderThickness="1"
                                        CornerRadius="18" Padding="3,2,10,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <AppBarToggleButton x:Name="MuteButton" Click="Mute_Click"
                                                            Style="{StaticResource MuteToggleButtonStyle}"
                                                            ToolTipService.ToolTip="Mute / Unmute (M)"
                                                            AutomationProperties.Name="Mute">
                                            <AppBarToggleButton.Icon>
                                                <SymbolIcon Symbol="Volume" />
                                            </AppBarToggleButton.Icon>
                                        </AppBarToggleButton>
                                        <Slider x:Name="VolumeSlider" Width="88" Minimum="0" Maximum="100"
                                                Value="70" ValueChanged="VolumeSlider_ValueChanged"
                                                VerticalAlignment="Center" Margin="0"
                                                ToolTipService.ToolTip="Volume (Up / Down arrows)"
                                                AutomationProperties.Name="Volume" />
                                        <TextBlock x:Name="VolumeText" Text="70%" FontSize="11" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Text, Consolas"
                                                   Foreground="#CBD5E1" Width="32" TextAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Toggle queue, snapshot, PiP, options, and full screen -->
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <AppBarToggleButton x:Name="CompactModeButton" Click="CompactMode_Click"
                                                        IsChecked="False"
                                                        Style="{StaticResource MediaToggleButtonStyle}"
                                                        ToolTipService.ToolTip="Toggle play queue (Compact mode)"
                                                        AutomationProperties.Name="Toggle play queue">
                                        <AppBarToggleButton.Icon>
                                            <SymbolIcon Symbol="ViewAll" />
                                        </AppBarToggleButton.Icon>
                                    </AppBarToggleButton>
                                    <AppBarButton x:Name="SnapshotButton" Click="Snapshot_Click"
                                                  Style="{StaticResource MediaTransportButtonStyle}"
                                                  ToolTipService.ToolTip="Take frame snapshot (S)"
                                                  AutomationProperties.Name="Take snapshot">
                                        <AppBarButton.Icon>
                                            <SymbolIcon Symbol="Camera" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton x:Name="PipButton" Click="Pip_Click"
                                                  Style="{StaticResource MediaTransportButtonStyle}"
                                                  ToolTipService.ToolTip="Picture-in-Picture / Mini player (P)"
                                                  AutomationProperties.Name="Picture-in-Picture">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE727;" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton x:Name="MoreActionsButton"
                                                  Style="{StaticResource MediaTransportButtonStyle}"
                                                  ToolTipService.ToolTip="Playback settings and options"
                                                  AutomationProperties.Name="Playback options">
                                        <AppBarButton.Icon>
                                            <SymbolIcon Symbol="More" />
                                        </AppBarButton.Icon>
                                        <AppBarButton.Flyout>
                                            <Flyout Placement="Top">
                                                <StackPanel MinWidth="290" Spacing="14" Padding="14">
                                                    <TextBlock Text="Playback options" FontSize="15"
                                                               FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                    
                                                    <!-- Speed -->
                                                    <StackPanel Orientation="Horizontal" Spacing="12"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="Speed" Width="80"
                                                                   VerticalAlignment="Center" Foreground="#94A3B8" />
                                                        <ComboBox x:Name="SpeedPicker" Width="160" SelectedIndex="2"
                                                                  ToolTipService.ToolTip="Playback speed"
                                                                  AutomationProperties.Name="Playback speed"
                                                                  SelectionChanged="SpeedPicker_SelectionChanged">
                                                            <ComboBoxItem Content="0.5×" />
                                                            <ComboBoxItem Content="0.75×" />
                                                            <ComboBoxItem Content="1×" />
                                                            <ComboBoxItem Content="1.25×" />
                                                            <ComboBoxItem Content="1.5×" />
                                                            <ComboBoxItem Content="2×" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Aspect Ratio -->
                                                    <StackPanel Orientation="Horizontal" Spacing="12"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="Aspect ratio" Width="80"
                                                                   VerticalAlignment="Center" Foreground="#94A3B8" />
                                                        <ComboBox x:Name="AspectRatioPicker" Width="160" SelectedIndex="0"
                                                                  ToolTipService.ToolTip="Aspect ratio (A)"
                                                                  AutomationProperties.Name="Aspect ratio"
                                                                  SelectionChanged="AspectRatioPicker_SelectionChanged">
                                                            <ComboBoxItem Content="Fit (Uniform)" />
                                                            <ComboBoxItem Content="Fill (Stretch)" />
                                                            <ComboBoxItem Content="Zoom (Crop)" />
                                                            <ComboBoxItem Content="Original (1:1)" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Multi Audio Track -->
                                                    <StackPanel Orientation="Horizontal" Spacing="12"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="Audio track" Width="80"
                                                                   VerticalAlignment="Center" Foreground="#94A3B8" />
                                                        <ComboBox x:Name="AudioTrackPicker" Width="160" SelectedIndex="0"
                                                                  ToolTipService.ToolTip="Audio track stream"
                                                                  AutomationProperties.Name="Audio track"
                                                                  SelectionChanged="AudioTrackPicker_SelectionChanged">
                                                            <ComboBoxItem Content="Default audio" />
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Subtitle selection -->
                                                    <TextBlock Text="Subtitles" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#94A3B8" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <ComboBox x:Name="SubtitlePicker" Width="185" SelectedIndex="0"
                                                                  ToolTipService.ToolTip="Subtitle track"
                                                                  AutomationProperties.Name="Subtitle track"
                                                                  SelectionChanged="SubtitlePicker_SelectionChanged">
                                                            <ComboBoxItem Content="Subtitles off" />
                                                        </ComboBox>
                                                        <AppBarButton x:Name="OpenSubtitleButton" Click="OpenSubtitle_Click"
                                                                      Style="{StaticResource MediaTransportButtonStyle}"
                                                                      ToolTipService.ToolTip="Load an external subtitle file"
                                                                      AutomationProperties.Name="Load subtitles">
                                                            <AppBarButton.Icon>
                                                                <SymbolIcon Symbol="Caption" />
                                                            </AppBarButton.Icon>
                                                        </AppBarButton>
                                                    </StackPanel>

                                                    <!-- Subtitle Sync Delay -->
                                                    <StackPanel Spacing="6">
                                                        <Grid>
                                                            <TextBlock Text="Subtitle sync delay" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="SubDelayText" Text="0 ms" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#A78BFA" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Button x:Name="SubDelayMinusBtn" Click="SubDelayMinus_Click" Content="-50 ms"
                                                                    Style="{StaticResource QueueActionButtonStyle}" Width="68"
                                                                    ToolTipService.ToolTip="Delay subtitles by -50ms (Z)" />
                                                            <Button x:Name="SubDelayPlusBtn" Click="SubDelayPlus_Click" Content="+50 ms"
                                                                    Style="{StaticResource QueueActionButtonStyle}" Width="68"
                                                                    ToolTipService.ToolTip="Advance subtitles by +50ms (X)" />
                                                            <Button x:Name="SubDelayResetBtn" Click="SubDelayReset_Click" Content="Reset"
                                                                    Style="{StaticResource QueueActionButtonStyle}" Width="60"
                                                                    ToolTipService.ToolTip="Reset subtitle delay to 0ms (C)" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Controls: Shuffle, Repeat, Stop -->
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <AppBarToggleButton x:Name="ShuffleButton" Click="Shuffle_Click"
                                                                            Style="{StaticResource MediaToggleButtonStyle}"
                                                                            ToolTipService.ToolTip="Shuffle queue"
                                                                            AutomationProperties.Name="Shuffle queue">
                                                            <AppBarToggleButton.Icon>
                                                                <SymbolIcon Symbol="Shuffle" />
                                                            </AppBarToggleButton.Icon>
                                                        </AppBarToggleButton>
                                                        <AppBarToggleButton x:Name="RepeatButton" Click="Repeat_Click"
                                                                            Style="{StaticResource MediaToggleButtonStyle}"
                                                                            ToolTipService.ToolTip="Repeat current video"
                                                                            AutomationProperties.Name="Repeat current video">
                                                            <AppBarToggleButton.Icon>
                                                                <SymbolIcon Symbol="RepeatOne" />
                                                            </AppBarToggleButton.Icon>
                                                        </AppBarToggleButton>
                                                        <AppBarButton x:Name="StopButton" Click="Stop_Click"
                                                                      Style="{StaticResource MediaTransportButtonStyle}"
                                                                      ToolTipService.ToolTip="Stop playback"
                                                                      AutomationProperties.Name="Stop">
                                                            <AppBarButton.Icon>
                                                                <SymbolIcon Symbol="Stop" />
                                                            </AppBarButton.Icon>
                                                        </AppBarButton>
                                                    </StackPanel>

                                                    <!-- Stereo balance -->
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Stereo balance" FontSize="12"
                                                                   FontWeight="SemiBold" Foreground="#94A3B8" />
                                                        <Slider x:Name="AudioBalanceSlider" Minimum="-100" Maximum="100"
                                                                Value="0" ValueChanged="AudioBalanceSlider_ValueChanged"
                                                                ToolTipService.ToolTip="Stereo balance: left to right"
                                                                AutomationProperties.Name="Stereo balance" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </AppBarButton.Flyout>
                                    </AppBarButton>
                                    <AppBarButton x:Name="FullWindowButton" Click="FullWindow_Click"
                                                  Style="{StaticResource MediaTransportButtonStyle}"
                                                  ToolTipService.ToolTip="Full screen (F)"
                                                  AutomationProperties.Name="Full screen">
                                        <AppBarButton.Icon>
                                            <SymbolIcon Symbol="FullScreen" />
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Drop Overlay -->
                <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#E60B0D13"
                        BorderBrush="#7C5CFC" BorderThickness="2" CornerRadius="16"
                        IsHitTestVisible="False">
                    <Border.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition />
                        </TransitionCollection>
                    </Border.Transitions>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <SymbolIcon Symbol="Add" Foreground="#A78BFA"
                                    HorizontalAlignment="Center" />
                        <TextBlock Text="Drop media or subtitles"
                                   Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Media joins the queue · subtitles attach to the current item"
                                   Foreground="#94A3B8" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Side: Play Queue Sidebar -->
        <Border x:Name="QueuePanel" Grid.Row="0" Grid.Column="1" Margin="0" Padding="16" CornerRadius="16"
                Background="#121520" BorderBrush="#222738" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Play queue" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#F8FAFC" />
                        <TextBlock x:Name="QueueCountText" Text="0 videos"
                                   FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="RecentFilesButton"
                                Style="{StaticResource QueueActionButtonStyle}"
                                ToolTipService.ToolTip="Recent videos &amp; resume"
                                AutomationProperties.Name="Recent videos">
                            <Button.Flyout>
                                <MenuFlyout x:Name="RecentMenuFlyout">
                                    <MenuFlyoutItem Text="No recent videos" IsEnabled="False" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <SymbolIcon Symbol="Clock" />
                        </Button>
                        <Button x:Name="OpenVideoButton" Click="OpenVideo_Click"
                                Style="{StaticResource QueueActionButtonStyle}"
                                ToolTipService.ToolTip="Choose video or audio files"
                                AutomationProperties.Name="Open media">
                            <SymbolIcon Symbol="OpenFile" />
                        </Button>
                        <Button x:Name="OpenStreamButton" Click="OpenStream_Click"
                                Style="{StaticResource QueueActionButtonStyle}"
                                ToolTipService.ToolTip="Open a network stream"
                                AutomationProperties.Name="Open network stream">
                            <SymbolIcon Symbol="World" />
                        </Button>
                        <Button x:Name="RemoveQueueItemButton" Click="RemoveQueueItem_Click"
                                IsEnabled="False"
                                Style="{StaticResource QueueActionButtonStyle}"
                                ToolTipService.ToolTip="Remove selected item"
                                AutomationProperties.Name="Remove selected item">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                        <Button x:Name="ClearQueueButton" Click="ClearQueue_Click"
                                IsEnabled="False"
                                Style="{StaticResource QueueActionButtonStyle}"
                                ToolTipService.ToolTip="Clear the play queue"
                                AutomationProperties.Name="Clear queue">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <ListView x:Name="PlaylistView" SelectionChanged="Playlist_SelectionChanged"
                              SelectionMode="Single" Background="Transparent" BorderThickness="0"
                              Foreground="#F1F5F9" Padding="0">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8" ColumnSpacing="10" CornerRadius="8"
                                      Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="6" Background="#1E2335"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Video" Foreground="#A78BFA"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13"
                                               Foreground="#F1F5F9" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="QueueEmptyState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </StackPanel.Transitions>
                        <Border Width="52" Height="52" CornerRadius="26" Background="#1A1E2C"
                                BorderBrush="#282E42" BorderThickness="1">
                            <SymbolIcon Symbol="Play" Foreground="#64748B"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nothing in the queue yet" FontSize="13"
                                   Foreground="#94A3B8" HorizontalAlignment="Center" />
                        <TextBlock Text="Add videos to build your watch list"
                                   FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
